# 必填：向 @BotFather 申请
BOT_TOKEN=

# 必填：https://my.telegram.org 申请（Local Bot API 用）
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Everything HTTP 搜索地址
EVERYTHING_BASE_URL=http://www.https.ng:1234

# 本机直接跑 bot 时用 127.0.0.1；docker compose 里会覆盖为服务名
LOCAL_BOT_API_URL=http://127.0.0.1:8081

# 与 Local Bot API 共享的临时目录（compose 中两边都挂这个路径）
DOWNLOAD_DIR=/tmp/bot-downloads

# 使用 file:// 把本地路径交给 Local Bot API（需共享 DOWNLOAD_DIR）
USE_FILE_URI=1

# 搜索与分页
PAGE_SIZE=10
MAX_RESULTS=50
SESSION_TTL_SECONDS=1800

# 公开 bot 限流
SEARCH_RATE_PER_MINUTE=10
DOWNLOAD_RATE_PER_MINUTE=3
MAX_CONCURRENT_DOWNLOADS=5
MAX_FILE_SIZE_BYTES=2147483648
